/*
  velociraptor-helm - declarative state reconciler (orgs, API client roles, per-org state).

  Why: much of Velociraptor's state is only applied on the server's very FIRST start
  (GUI.initial_orgs, Frontend.default_client_monitoring_artifacts...) or only through the API
  (org_create(), roles, monitoring tables, tools, VQL secrets, hunts). This program runs in a
  native sidecar of the master and does not exit on start-up failures (a native sidecar that
  crash-loops would delay the server's own start). Every Period seconds it runs `Inner`
  through the API client (`--api_config`, in-pod) to:
    - create the declared orgs that do not exist yet (never renames, never deletes);
    - grant the initial admin the administrator role in every declared org;
    - grant the API clients their roles (authoritative for those users);
    - per org in State:
        users             roles authoritative for the declared users (others untouched)
        clientMonitoring  the whole client event table (authoritative, GUI edits overwritten)
        serverMonitoring  the whole server event table (authoritative)
        tools             added / updated when the declared hash differs (never removed)
        secrets           VQL secrets, values read SERVER-SIDE from a mounted Secret file:
                          they never appear in the query text the server logs
        hunts             re-launched when the last hunt tagged helm:<name> is older than
                          `every` (never deleted)
  After 5 failed attempts the program exits non-zero: kubelet restarts the sidecar, and the
  PrometheusRule alert VelociraptorReconcilerFailing fires on those restarts.

  Inputs (--env): Bin, ApiConfig, Orgs, Admin, ApiClients, State (JSON, prepared by the chart),
  Period (seconds), ManagedOrgs (JSON list of non-root org ids), ApiUser (this sidecar's API
  user), LedgerFile (server-side path of the API client ledger, see below); client config export: ExportOrgs (JSON list of org ids, "[]" = off),
  ExportPrefix, ExportKey, Packages ("true"/"false"), Release, KubeAPI, SADir.
*/

LET Inner = '''
LET Wanted <= parse_json_array(data=Orgs)
LET Existing <= SELECT OrgId FROM orgs()
LET Missing <= SELECT id, name FROM foreach(row=Wanted) WHERE NOT (id in Existing.OrgId)
LET Clients <= parse_json_array(data=ApiClients)

-- API client revocation. Velociraptor authenticates an API client by CA signature + CN only
-- (no revocation list), so a certificate stays usable as long as its user exists. A ledger in
-- the datastore (next to the users it describes) records the API clients ever declared:
--   - a client removed from (or renamed in) apiClients is revoked: its user is deleted;
--   - a revoked name stays revoked: re-declaring it would revive every certificate issued
--     under it, so it is refused (not granted) until removed from the ledger by hand.
LET Declared <= if(condition=Clients, then=Clients.name, else=[])
LET Ledger <= if(condition=LedgerFile, then=parse_json(data=read_file(filename=LedgerFile)))
LET PrevIssued <= if(condition=Ledger.issued, then=Ledger.issued, else=[])
LET PrevRevoked <= if(condition=Ledger.revoked, then=Ledger.revoked, else=[])
LET NewlyRevoked <= filter(list=PrevIssued, condition="x => NOT x in Declared AND NOT x in PrevRevoked")
LET Revoked <= PrevRevoked + NewlyRevoked
LET Refused <= filter(list=Declared, condition="x => x in Revoked")
LET Active <= filter(list=Declared, condition="x => NOT x in Revoked")
LET RevokedUsers <= SELECT _value AS name, user_delete(user=_value, really_do_it=TRUE) AS Deleted
  FROM foreach(row=Revoked) WHERE user(user=_value).name
LET NewLedger <= serialize(format="json", item=dict(issued=Active, revoked=Revoked))
LET LedgerWritten <= if(condition=LedgerFile AND NewLedger != serialize(format="json",
                            item=dict(issued=PrevIssued, revoked=PrevRevoked)),
    then=copy(accessor="data", filename=NewLedger, dest=LedgerFile))
LET States <= parse_json_array(data=State)

-- Materialized in this order: create the orgs, then grant ourselves (the reconciler's own API
-- user) administrator + api in every managed org: rights inherited from root are not enough
-- inside an org (e.g. COLLECT_SERVER is denied), an explicit grant is. Since 0.77.4 only the
-- api role carries ANY_QUERY (administrator no longer does).
LET CreatedOrgs <= SELECT id, org_create(name=name, org_id=id).id AS OrgId FROM Missing
LET Managed <= parse_json_array(data=ManagedOrgs)
LET SelfGranted <= if(condition=Managed,
    then=user_grant(user=ApiUser, roles=["administrator", "api"], orgs=Managed))

-- Roles and extra permissions are authoritative: user_grant replaces both (no policy = roles
-- only), but needs an existing user, hence user_create first. policy: JSON string or "".
LET setRoles(name, roles, orgs, policy) = if(
    condition=user(user=name).name OR user_create(user=name, roles=roles, orgs=orgs),
    then=user_grant(user=name, roles=roles, orgs=orgs,
                    policy=if(condition=policy, then=parse_json(data=policy))))

-- Most recent hunt carrying the chart's tag (create_time, microseconds).
LET lastHunt(htag) = SELECT create_time FROM hunts() WHERE htag in tags
  ORDER BY create_time DESC LIMIT 1

-- Applied inside query(org_id=...): every call below acts on that org.
LET applyOrg = SELECT
    { SELECT name, setRoles(name=name, roles=roles, orgs=[OrgId], policy=policy) AS Granted
      FROM foreach(row=UserList) WHERE NOT name in RevokedNames } AS Users,
    if(condition=ClientMonitoring,
       then=set_client_monitoring(value=parse_json(data=ClientMonitoring)).version) AS ClientMonitoring,
    if(condition=ServerMonitoring,
       then=set_server_monitoring(value=parse_json(data=ServerMonitoring)).artifacts) AS ServerMonitoring,
    { SELECT name,
             if(condition=inventory_get(tool=name).Definition.hash = hash, then="present",
                else=inventory_add(tool=name, url=url, hash=hash, serve_locally=serveLocally,
                                   filename=filename, version=version).name) AS Tool
      FROM foreach(row=ToolList) } AS Tools,
    { SELECT name, secret_add(name=name, type=type,
                              secret=parse_json(data=read_file(filename=file))) AS Secret
      FROM foreach(row=SecretList) } AS Secrets,
    { SELECT name, Last,
             if(condition=NOT Last OR (now() - Last / 1000000) >= everySeconds,
                then=hunt(description="helm: " + name, tags=[tag], artifacts=artifacts,
                          spec=if(condition=spec, then=parse_json(data=spec)),
                          include_labels=labels, os=os,
                          expires=now() + expiresSeconds).HuntId,
                else="recent") AS Hunt
      FROM foreach(row=HuntList, query={
        SELECT name, tag, artifacts, spec, labels, os, everySeconds, expiresSeconds,
               lastHunt(htag=tag)[0].create_time AS Last
        FROM scope() }) } AS Hunts
  FROM scope()

SELECT Wanted.id AS Declared, CreatedOrgs AS Created, SelfGranted,
       if(condition=Admin AND Wanted,
          then=user_grant(user=Admin, roles=["administrator"], orgs=Wanted.id)) AS AdminGranted,
       { SELECT name, roles, orgs, setRoles(name=name, roles=roles, orgs=orgs, policy=policy) AS Granted
         FROM foreach(row=Clients) WHERE name in Active } AS ApiClients,
       RevokedUsers, Refused AS RefusedApiClients,
       { SELECT * FROM foreach(row=States, query={
           -- query() opens a fresh scope: copy the helper definitions into it.
           SELECT id AS Org, * FROM query(org_id=id, query=applyOrg,
             copy_env=["setRoles", "lastHunt"], env=dict(
             -- the chart always provides these lists (possibly empty)
             OrgId=id, UserList=users, ClientMonitoring=clientMonitoring,
             ServerMonitoring=serverMonitoring, ToolList=tools, SecretList=secrets,
             HuntList=hunts, RevokedNames=Revoked))
         }) } AS State
FROM scope()
'''

LET call(vql) = SELECT * FROM execve(
    argv=[Bin, "--api_config", ApiConfig, "--nobanner", "query", "--format=jsonl",
          "--env", "Orgs=" + Orgs, "--env", "Admin=" + Admin,
          "--env", "ApiClients=" + ApiClients, "--env", "State=" + State,
          "--env", "ManagedOrgs=" + ManagedOrgs, "--env", "ApiUser=" + ApiUser,
          "--env", "LedgerFile=" + LedgerFile, vql],
    sep="\x00\x00", length=2000000)

/*
  Client config export (ExportOrgs non-empty): each org's client config (CA, nonce, server
  URLs) is written to the Secret <ExportPrefix><org id, lowercased> only when it changed. The
  sidecar talks to the Kubernetes API with a projected token mounted in this container only.
  On a change, Packages=true rebuilds the MSI/DEB/RPM installers of that org on the server.
  Configs are never logged (only the action per org).
*/
LET Exporting <= ExportOrgs AND ExportOrgs != "[]"
LET kubeAuth = "Bearer " + read_file(filename=SADir + "/token")
LET KubeCA <= if(condition=Exporting, then=read_file(filename=SADir + "/ca.crt"))
LET SecretsURL <= if(condition=Exporting,
    then=KubeAPI + "/api/v1/namespaces/" + read_file(filename=SADir + "/namespace") + "/secrets")
LET k8s(method, url, body, ctype) = SELECT Response, Content FROM http_client(
    url=url, method=method, data=body, root_ca=KubeCA, chunk_size=1000000,
    headers=dict(Authorization=kubeAuth, `Content-Type`=ctype, Accept="application/json"))

LET ExportInner = '''
SELECT OrgId, _client_config AS Config FROM orgs()
WHERE OrgId in parse_json_array(data=ExportOrgs)
'''
LET PackagesInner = '''
SELECT * FROM query(org_id=Org, query={
  SELECT collect_client(client_id="server",
           artifacts=["Server.Utils.CreateMSI", "Server.Utils.CreateLinuxPackages"]).flow_id AS Flow
  FROM scope() })
'''
LET apiRows(vql, kv) = SELECT parse_json(data=Stdout) AS R FROM execve(
    argv=[Bin, "--api_config", ApiConfig, "--nobanner", "query", "--format=jsonl", "--env", kv, vql],
    sep="\n", length=1000000)
  WHERE Stdout =~ "^\\{"

LET exportPlan = SELECT * FROM foreach(row={
    SELECT R.OrgId AS Org, R.Config AS Config, ExportPrefix + lowcase(string=R.OrgId) AS Name
    FROM apiRows(vql=ExportInner, kv="ExportOrgs=" + ExportOrgs)
  }, query={
    SELECT Org, Config, Name, G[0].Response AS Status,
           get(item=parse_json(data=G[0].Content).data, field=ExportKey) AS Current
    FROM foreach(row={
      SELECT k8s(method="GET", url=SecretsURL + "/" + Name, body="", ctype="application/json") AS G
      FROM scope() })
  })
LET export = SELECT Org, Name, Action,
       if(condition=Action = "created",
          then=k8s(method="POST", url=SecretsURL, ctype="application/json",
                   body=serialize(format="json", item=dict(
                     apiVersion="v1", kind="Secret", type="Opaque",
                     metadata=dict(name=Name, labels=dict(
                       `app.kubernetes.io/part-of`="velociraptor",
                       `velociraptor.app/release`=Release,
                       `velociraptor.app/org`=Org,
                       `velociraptor.app/managed-by`="velociraptor-helm-state")),
                     data=to_dict(item={SELECT ExportKey AS _key,
                                         base64encode(string=Config) AS _value FROM scope()}))))[0].Response,
          else=if(condition=Action = "updated",
                  then=k8s(method="PATCH", url=SecretsURL + "/" + Name,
                           ctype="application/merge-patch+json",
                           body=serialize(format="json", item=dict(
                             data=to_dict(item={SELECT ExportKey AS _key,
                                                 base64encode(string=Config) AS _value FROM scope()}))))[0].Response)) AS Response,
       if(condition=(Action = "created" OR Action = "updated") AND Packages = "true",
          then=apiRows(vql=PackagesInner, kv="Org=" + Org)[0].R.Flow) AS PackagesFlow
  FROM foreach(row={
    SELECT Org, Config, Name,
           if(condition=Status = 404, then="created",
              else=if(condition=Status = 200 AND Current = base64encode(string=Config), then="unchanged",
                      else=if(condition=Status = 200, then="updated", else="error"))) AS Action
    FROM exportPlan })

LET innerAttempt = SELECT * FROM foreach(row={
  SELECT timestamp(epoch=now()) AS Time,
       R[-1].ReturnCode = 0 AS OK,
       if(condition=R[-1].ReturnCode = 0,
          then=parse_json(data=join(array=R.Stdout, sep="")),
          -- the CLI prints its error on stdout or stderr depending on the version
          else=regex_replace(source=join(array=R.Stdout + R.Stderr, sep="\n"),
                             re='''(?s)^.*(velociraptor: error: [^\n]*).*$''', replace="$1")
               || "server API not reachable yet, will retry") AS Result
  FROM foreach(row={SELECT call(vql=Inner) AS R FROM scope()})
}, query={
  SELECT Time, OK, Result,
         log(level=if(condition=OK, then="INFO", else="WARN"),
             message="reconcile: %v", dedup=-1,
             args=regex_replace(source=serialize(item=dict(OK=OK, Result=Result)),
                                re='''\s*\n\s*''', replace=" ")) AS Logged
  FROM scope()
})

-- One row per exported org (export runs once per attempt; row values are memoized).
LET exportAttempt = SELECT timestamp(epoch=now()) AS Time,
       NOT (Action = "error" OR (Action = "created" AND Response != 201)
            OR (Action = "updated" AND Response != 200)) AS OK,
       dict(Org=Org, Secret=Name, Action=Action, Response=Response, PackagesFlow=PackagesFlow) AS Result,
       log(level=if(condition=Action = "error", then="WARN", else="INFO"),
           message="export: org=%v secret=%v action=%v http=%v packages=%v", dedup=-1,
           args=[Org, Name, Action, Response, PackagesFlow]) AS Logged
  FROM export

LET attempt = SELECT * FROM chain(
  a=innerAttempt,
  b={ SELECT * FROM if(condition=Exporting, then=exportAttempt) })

-- Only failed attempts reach the LIMIT: 5 failures end the loop.
SELECT Time, Result FROM foreach(row={SELECT * FROM clock(period=int(int=Period), start=0)},
                                 query=attempt)
WHERE NOT OK
LIMIT 5

SELECT log(level="ERROR", message="reconcile: 5 failed attempts, exiting so that kubelet restarts the sidecar") FROM scope()
