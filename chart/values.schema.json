{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "velociraptor chart values",
  "type": "object",
  "properties": {
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "replicaCount": { "type": "integer", "minimum": 1, "maximum": 1,
      "description": "Filesystem datastore is single-writer; must stay 1." },
    "image": {
      "type": "object",
      "properties": {
        "registry": { "type": "string" },
        "repository": { "type": "string" },
        "tag": { "type": "string" },
        "digest": { "type": "string" },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      },
      "required": ["repository"]
    },
    "imagePullSecrets": { "type": "array" },
    "config": {
      "type": "object",
      "properties": {
        "existingSecret": { "type": "string" },
        "secretKey": { "type": "string" },
        "mountPath": { "type": "string" },
        "inline": { "type": "string" },
        "bootstrap": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "secretName": { "type": "string" },
            "importFrom": { "type": "string" },
            "certificateValidityDays": { "type": "integer", "minimum": 2 },
            "renewBeforeDays": { "type": "integer", "minimum": 1 },
            "restartOnRenew": { "type": "boolean" },
            "renewal": {
              "type": "object",
              "properties": {
                "enabled": { "type": "boolean" },
                "schedule": { "type": "string" },
                "timeZone": { "type": "string" }
              }
            },
            "caWarnDays": { "type": "integer", "minimum": 1 },
            "activeDeadlineSeconds": { "type": "integer", "minimum": 30 },
            "resources": { "type": "object" }
          }
        },
        "manageServerConfig": { "type": "boolean",
          "description": "Render operational config from values and merge onto the base (secrets)." },
        "server": {
          "type": "object",
          "properties": {
            "clientServerUrls": { "type": "array", "items": { "type": "string" } },
            "datastoreImplementation": { "type": "string" },
            "logging": {
              "type": "object",
              "properties": {
                "separateLogsPerComponent": { "type": "boolean" },
                "outputDirectory": { "type": "string" },
                "rotationTime": { "type": "integer" },
                "maxAge": { "type": "integer" },
                "remoteSyslogServer": { "type": "string" },
                "remoteSyslogProtocol": { "type": "string" },
                "remoteSyslogComponents": { "type": "array" }
              }
            },
            "client": { "type": "object" },
            "api": { "type": "object" },
            "gui": { "type": "object" },
            "frontend": { "type": "object" },
            "datastore": { "type": "object" },
            "monitoring": { "type": "object" },
            "defaults": { "type": "object" },
            "security": { "type": "object" },
            "minion": { "type": "object" },
            "serverType": { "type": "string" },
            "autocertDomain": { "type": "string" },
            "autocertCertCache": { "type": "string" },
            "lockdown": { "type": ["boolean", "null"] },
            "debugMode": { "type": ["boolean", "null"] },
            "extraConfig": { "type": "object" }
          }
        },
        "initializeServer": { "type": "boolean" },
        "overlay": {
          "type": "object",
          "properties": {
            "image": {
              "type": "object",
              "properties": {
                "repository": { "type": "string" },
                "tag": { "type": "string" },
                "digest": { "type": "string" },
                "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
              }
            }
          }
        }
      }
    },
    "frontend": {
      "type": "object",
      "properties": {
        "containerPort": { "type": "integer" },
        "apiPort": { "type": "integer" },
        "minions": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "replicas": { "type": "integer", "minimum": 1 },
            "resources": { "type": "object" },
            "podAnnotations": { "type": "object" },
            "nodeSelector": { "type": "object" },
            "tolerations": { "type": "array" },
            "affinity": { "type": "object" }
          }
        },
        "service": {
          "type": "object",
          "properties": {
            "type": { "type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
            "port": { "type": "integer" },
            "annotations": { "type": "object" },
            "loadBalancerIP": { "type": "string" },
            "loadBalancerSourceRanges": { "type": "array" },
            "externalTrafficPolicy": { "type": "string", "enum": ["Cluster", "Local"] }
          }
        }
      }
    },
    "gui": {
      "type": "object",
      "properties": {
        "containerPort": { "type": "integer" },
        "publicUrl": { "type": "string" },
        "basePath": { "type": "string" },
        "initialAdmin": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "username": { "type": "string", "minLength": 1 },
            "existingSecret": { "type": "string" },
            "passwordKey": { "type": "string" }
          }
        },
        "oidc": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "name": { "type": "string" },
            "issuer": { "type": "string" },
            "clientId": { "type": "string" },
            "avatar": { "type": "string" },
            "existingSecret": { "type": "string" },
            "existingSecretKey": { "type": "string" },
            "clientSecret": { "type": "string" }
          }
        },
        "service": { "type": "object" },
        "ingress": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "className": { "type": "string" },
            "annotations": { "type": "object" },
            "hosts": { "type": "array" },
            "tls": { "type": "array" }
          }
        }
      }
    },
    "persistence": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "existingClaim": { "type": "string",
          "description": "Externally-provisioned PVC (NFS/EFS RWX) for the datastore; disables the chart-managed volumeClaimTemplate." },
        "storageClass": { "type": "string" },
        "accessModes": { "type": "array" },
        "size": { "type": "string" },
        "annotations": { "type": "object" },
        "mountPath": { "type": "string" }
      }
    },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" },
        "annotations": { "type": "object" },
        "automountServiceAccountToken": { "type": "boolean" }
      }
    },
    "podSecurityContext": { "type": "object" },
    "securityContext": { "type": "object" },
    "resources": { "type": "object" },
    "nodeSelector": { "type": "object" },
    "tolerations": { "type": "array" },
    "affinity": { "type": "object" },
    "topologySpreadConstraints": { "type": "array" },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "frontendAllowedCIDRs": { "type": "array", "items": { "type": "string" } },
        "guiAllowedFrom": { "type": "array" },
        "metricsAllowedFrom": { "type": "array" },
        "oidcEgressCIDRs": { "type": "array", "items": { "type": "string" } },
        "oidcEgressPort": { "type": "integer" },
        "toolsEgressCIDRs": { "type": "array", "items": { "type": "string" } },
        "kubeApiEgress": {
          "type": "object",
          "properties": {
            "cidrs": { "type": "array", "items": { "type": "string" } },
            "ports": { "type": "array", "items": { "type": "integer" } }
          }
        },
        "extraEgress": { "type": "array" }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "minAvailable": { "type": ["string", "integer"] },
        "maxUnavailable": { "type": ["string", "integer"] }
      }
    },
    "monitoring": {
      "type": "object",
      "properties": {
        "containerPort": { "type": "integer" }
      }
    },
    "serviceMonitor": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "interval": { "type": "string" },
        "scrapeTimeout": { "type": "string" },
        "port": { "type": "string" },
        "path": { "type": "string" },
        "scheme": { "type": "string", "enum": ["http", "https"] }
      }
    },
    "orgs": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "name"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "name": { "type": "string", "minLength": 1 }
            }
          }
        },
        "reconcilePeriodSeconds": { "type": "integer", "minimum": 10, "deprecated": true, "description": "Deprecated: use state.reconcilePeriodSeconds" },
        "resources": { "type": "object", "deprecated": true, "description": "Deprecated: use state.resources" }
      }
    },
    "state": {
      "type": "object",
      "properties": {
        "reconcilePeriodSeconds": { "type": "integer", "minimum": 10 },
        "resources": { "type": "object" },
        "orgs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "users": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["name", "roles"],
                  "properties": {
                    "name": { "type": "string", "minLength": 1 },
                    "roles": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
                    "permissions": { "type": "array", "items": { "type": "string", "enum": ["all_query", "any_query", "read_results", "label_clients", "collect_client", "collect_basic", "start_hunt", "collect_server", "artifact_writer", "server_artifact_writer", "execve", "notebook_editor", "org_admin", "impersonation", "server_admin", "filesystem_read", "filesystem_write", "network", "machine_state", "prepare_results", "delete_results", "datastore_access", "ALL_QUERY", "ANY_QUERY", "READ_RESULTS", "LABEL_CLIENTS", "COLLECT_CLIENT", "COLLECT_BASIC", "START_HUNT", "COLLECT_SERVER", "ARTIFACT_WRITER", "SERVER_ARTIFACT_WRITER", "EXECVE", "NOTEBOOK_EDITOR", "ORG_ADMIN", "IMPERSONATION", "SERVER_ADMIN", "FILESYSTEM_READ", "FILESYSTEM_WRITE", "NETWORK", "MACHINE_STATE", "PREPARE_RESULTS", "DELETE_RESULTS", "DATASTORE_ACCESS"] }, "uniqueItems": true }
                  }
                }
              },
              "clientMonitoring": {
                "type": "object",
                "properties": { "all": { "type": "array" }, "labels": { "type": "object" } }
              },
              "serverMonitoring": { "type": "array" },
              "tools": { "type": "array" },
              "secrets": { "type": "array" },
              "hunts": { "type": "array" }
            }
          }
        }
      }
    },
    "prometheusRule": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "namespace": { "type": "string" },
        "labels": { "type": "object" },
        "kubeStateMetrics": { "type": "boolean" },
        "clientsDrop": {
          "type": "object",
          "properties": {
            "ratio": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
            "window": { "type": "string" },
            "minClients": { "type": "integer", "minimum": 0 },
            "for": { "type": "string" }
          }
        },
        "extraRules": { "type": "array" }
      }
    },
    "api": {
      "type": "object",
      "properties": {
        "expose": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "allowedFrom": { "type": "array" }
          }
        },
        "service": { "type": "object" }
      }
    },
    "apiClients": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "roles"],
        "properties": {
          "name": { "type": "string", "pattern": "^[A-Za-z0-9._@-]+$", "not": { "enum": ["GRPC_GW", "velociraptor-helm"] } },
          "validityDays": { "type": "integer", "minimum": 3 },
          "roles": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "permissions": { "type": "array", "items": { "type": "string", "enum": ["all_query", "any_query", "read_results", "label_clients", "collect_client", "collect_basic", "start_hunt", "collect_server", "artifact_writer", "server_artifact_writer", "execve", "notebook_editor", "org_admin", "impersonation", "server_admin", "filesystem_read", "filesystem_write", "network", "machine_state", "prepare_results", "delete_results", "datastore_access", "ALL_QUERY", "ANY_QUERY", "READ_RESULTS", "LABEL_CLIENTS", "COLLECT_CLIENT", "COLLECT_BASIC", "START_HUNT", "COLLECT_SERVER", "ARTIFACT_WRITER", "SERVER_ARTIFACT_WRITER", "EXECVE", "NOTEBOOK_EDITOR", "ORG_ADMIN", "IMPERSONATION", "SERVER_ADMIN", "FILESYSTEM_READ", "FILESYSTEM_WRITE", "NETWORK", "MACHINE_STATE", "PREPARE_RESULTS", "DELETE_RESULTS", "DATASTORE_ACCESS"] }, "uniqueItems": true },
          "orgs": { "type": "array", "items": { "type": "string" } },
          "secretName": { "type": "string" },
          "secretKey": { "type": "string" }
        }
      }
    },
    "clientConfig": {
      "type": "object",
      "properties": {
        "export": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "orgs": { "type": "array", "items": { "type": "string" } },
            "secretPrefix": { "type": "string" },
            "key": { "type": "string" }
          }
        },
        "packages": { "type": "object", "properties": { "enabled": { "type": "boolean" } } }
      }
    },
    "backup": {
      "type": "object",
      "properties": {
        "s3": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "bucket": { "type": "string" },
            "region": { "type": "string" },
            "endpoint": { "type": "string" },
            "pathStyle": { "type": "boolean" },
            "skipVerify": { "type": "boolean" },
            "prefix": { "type": "string" },
            "serverSideEncryption": { "type": "string", "enum": ["", "AES256", "aws:kms"] },
            "kmsKeyId": { "type": "string" },
            "existingSecret": { "type": "string" },
            "includeIdentity": { "type": "boolean" },
            "intervalSeconds": { "type": "integer", "minimum": 60 },
            "egress": { "type": "object" },
            "resources": { "type": "object" }
          }
        }
      }
    },
    "extraContainers": { "type": "array" },
    "extraInitContainers": { "type": "array" },
    "extraObjects": { "type": "array" },
    "customArtifacts": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "path": { "type": "string" },
        "existingConfigMap": { "type": "string" },
        "existingConfigMaps": { "type": "array", "items": { "type": "string" } },
        "files": { "type": "object" }
      }
    },
    "tmpDir": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "sizeLimit": { "type": "string" }
      }
    },
    "extraEnv": { "type": "array" },
    "extraVolumes": { "type": "array" },
    "extraVolumeMounts": { "type": "array" },
    "extraArgs": { "type": "array" }
  }
}
