/*
  velociraptor-helm - declarative orgs (multi-tenancy) reconciler.

  Why: GUI.initial_orgs is only honoured on the server's very FIRST start (orgs added to
  the config later are silently ignored), and org_create() refuses to run offline
  ("not available when running without a frontend service"). Orgs must be created
  through the live server API.

  How: this program runs in a native sidecar of the master and NEVER exits (a native
  sidecar that crash-loops would delay the server's own start). Every Period seconds it
  runs `Inner` through the API client (`--api_config`, in-pod) to:
    - create the declared orgs that do not exist yet (never renames, never deletes);
    - grant the initial admin the administrator role in every declared org.
  While the API is not up yet, attempts fail and are simply retried.

  Inputs (--env): Bin, ApiConfig, Orgs (JSON array of {"id", "name"}), Admin (may be
  empty), Period (seconds).
*/

LET Inner = '''
LET Wanted <= parse_json_array(data=Orgs)
LET Existing <= SELECT OrgId FROM orgs()
LET Missing <= SELECT id, name FROM foreach(row=Wanted) WHERE NOT (id in Existing.OrgId)
SELECT Wanted.id AS Declared,
       { SELECT id, org_create(name=name, org_id=id).id AS OrgId FROM Missing } AS Created,
       if(condition=Admin,
          then=user_grant(user=Admin, roles=["administrator"], orgs=Wanted.id)) AS AdminGranted
FROM scope()
'''

LET call(vql) = SELECT * FROM execve(
    argv=[Bin, "--api_config", ApiConfig, "--nobanner", "query", "--format=jsonl",
          "--env", "Orgs=" + Orgs, "--env", "Admin=" + Admin, vql],
    sep="\x00\x00", length=10000000)

LET attempt = SELECT timestamp(epoch=now()) AS Time,
       R[-1].ReturnCode = 0 AS OK,
       if(condition=R[-1].ReturnCode = 0,
          then=parse_json(data=join(array=R.Stdout, sep="")),
          else=regex_replace(source=join(array=R.Stderr, sep=""),
                             re='''(?s)^.*(velociraptor: error: [^\n]*).*$''', replace="$1")
               || "server API not reachable yet, will retry") AS Result
  FROM foreach(row={SELECT call(vql=Inner) AS R FROM scope()})

SELECT * FROM foreach(row={SELECT * FROM clock(period=int(int=Period), start=0)},
                      query=attempt)
